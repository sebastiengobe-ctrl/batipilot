generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  COLLABORATOR
  CLIENT
  COMPANY
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PROSPECT
  DESIGN
  CONSULTATION
  CONSTRUCTION
  RECEPTION
  CLOSED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DocumentVisibility {
  INTERNAL
  CLIENT
  COMPANY
  PUBLIC
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum SignatureStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  REFUSED
  EXPIRED
  CANCELLED
}

enum ObservationStatus {
  OPEN
  CORRECTED
  TO_VERIFY
  CLOSED
  OVERDUE
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  agencies  Agency[]
  users     User[]
  clients   Client[]
  companies Company[]
  projects  Project[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  prospects Prospect[]
}

model Agency {
  id             String       @id @default(cuid())
  name           String
  address        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  role                 Role                 @default(COLLABORATOR)
  status               UserStatus           @default(ACTIVE)
  jobTitle             String?
  capacityHours        Float                @default(35)
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions             Session[]
  memberships          ProjectMember[]
  assignedTasks        WorkTask[]
  timeEntries          TimeEntry[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  authoredGenerations  DocumentGeneration[] @relation("GeneratedBy")
  notifications        Notification[]
  responsibleProspects Prospect[]           @relation("ProspectResponsible")

  @@index([organizationId, role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  contacts       Json?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  createdAt      DateTime     @default(now())
}

model Company {
  id             String        @id @default(cuid())
  name           String
  trade          String?
  email          String?
  phone          String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lots           Lot[]
  observations   Observation[]
  contracts      Contract[]
}

model Project {
  id                  String               @id @default(cuid())
  name                String
  reference           String               @unique
  address             String?
  description         String?
  status              ProjectStatus        @default(PROSPECT)
  progress            Int                  @default(0)
  worksBudget         Decimal?
  feesBudget          Decimal?
  startDate           DateTime?
  endDate             DateTime?
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members             ProjectMember[]
  phases              Phase[]
  lots                Lot[]
  tasks               WorkTask[]
  planning            PlanningTask[]
  documents           Document[]
  meetings            Meeting[]
  observations        Observation[]
  signatures          SignatureRequest[]
  budgets             BudgetLine[]
  receptions          Reception[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contracts           Contract[]
  documentGenerations DocumentGeneration[]
  notifications       Notification[]
  feeInvoices         FeeInvoice[]

  @@index([organizationId, status])
}

model ProjectMember {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole String

  @@unique([projectId, userId])
}

model Phase {
  id            String         @id @default(cuid())
  code          String
  name          String
  responsibleId String?
  startDate     DateTime?
  endDate       DateTime?
  progress      Int            @default(0)
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables  Deliverable[]
  tasks         WorkTask[]
  planning      PlanningTask[]

  @@unique([projectId, code])
}

model Deliverable {
  id      String         @id @default(cuid())
  name    String
  dueAt   DateTime?
  status  ApprovalStatus @default(DRAFT)
  phaseId String
  phase   Phase          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model Lot {
  id             String         @id @default(cuid())
  number         String
  name           String
  estimate       Decimal?
  contractAmount Decimal?
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  planning       PlanningTask[]
  observations   Observation[]
  contracts      Contract[]

  @@unique([projectId, number])
}

model PlanningTask {
  id            String    @id @default(cuid())
  title         String
  start         DateTime
  end           DateTime
  progress      Int       @default(0)
  milestone     Boolean   @default(false)
  baselineStart DateTime?
  baselineEnd   DateTime?
  dependencyIds Json?
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId       String?
  phase         Phase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  lotId         String?
  lot           Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
}

model WorkTask {
  id           String      @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus  @default(TODO)
  priority     Priority    @default(NORMAL)
  startAt      DateTime?
  dueAt        DateTime?
  plannedHours Float?
  actualHours  Float?
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId      String?
  phase        Phase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  timeEntries  TimeEntry[]
  createdAt    DateTime    @default(now())
}

model TimeEntry {
  id     String   @id @default(cuid())
  hours  Float
  date   DateTime
  note   String?
  taskId String
  task   WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meeting {
  id          String    @id @default(cuid())
  number      Int
  date        DateTime
  weather     String?
  attendees   Json?
  notes       Json?
  publishedAt DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
}

model Observation {
  id          String            @id @default(cuid())
  title       String
  description String?
  location    String?
  dueAt       DateTime?
  priority    Priority          @default(NORMAL)
  status      ObservationStatus @default(OPEN)
  photos      Json?
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lotId       String?
  lot         Lot?              @relation(fields: [lotId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Document {
  id             String             @id @default(cuid())
  name           String
  category       String
  mimeType       String?
  storageKey     String?
  version        Int                @default(1)
  visibility     DocumentVisibility @default(INTERNAL)
  approvalStatus ApprovalStatus     @default(DRAFT)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  versions       DocumentVersion[]
}

model SignatureRequest {
  id          String          @id @default(cuid())
  title       String
  status      SignatureStatus @default(DRAFT)
  provider    String?
  providerId  String?
  signers     Json
  dueAt       DateTime?
  evidenceUrl String?
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
}

model BudgetLine {
  id        String  @id @default(cuid())
  label     String
  category  String
  budget    Decimal @default(0)
  committed Decimal @default(0)
  paid      Decimal @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Reception {
  id        String    @id @default(cuid())
  date      DateTime
  status    String
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reserves  Reserve[]
}

model Reserve {
  id          String            @id @default(cuid())
  title       String
  location    String?
  status      ObservationStatus @default(OPEN)
  dueAt       DateTime?
  receptionId String
  reception   Reception         @relation(fields: [receptionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model Contract {
  id            String               @id @default(cuid())
  number        String
  title         String
  initialAmount Decimal              @default(0)
  status        String               @default("DRAFT")
  signedAt      DateTime?
  projectId     String
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lotId         String?
  lot           Lot?                 @relation(fields: [lotId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  amendments    Amendment[]
  applications  PaymentApplication[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

model Amendment {
  id         String    @id @default(cuid())
  number     Int
  label      String
  amount     Decimal   @default(0)
  status     String    @default("DRAFT")
  approvedAt DateTime?
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, number])
}

model PaymentApplication {
  id         String    @id @default(cuid())
  number     Int
  period     String
  amount     Decimal   @default(0)
  approved   Decimal   @default(0)
  paid       Decimal   @default(0)
  status     String    @default("DRAFT")
  dueAt      DateTime?
  paidAt     DateTime?
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, number])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  version    Int
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  sha256     String?
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
}

model DocumentTemplate {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String
  storageKey String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model DocumentGeneration {
  id          String   @id @default(cuid())
  type        String
  storageKey  String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedBy String
  author      User     @relation("GeneratedBy", fields: [generatedBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  message   String?
  href      String?
  readAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum ProspectStatus {
  NEW
  QUALIFY
  FIRST_MEETING
  STUDY
  PROPOSAL_SENT
  FOLLOW_UP
  WON
  LOST
  ON_HOLD
}

model Prospect {
  id                 String             @id @default(cuid())
  firstName          String?
  lastName           String
  email              String?
  phone              String?
  projectAddress     String?
  projectType        String?
  constructionType   String?
  source             String?
  status             ProspectStatus     @default(NEW)
  probability        Int                @default(10)
  worksBudget        Decimal?
  feesEstimate       Decimal?
  nextAction         String?
  comment            String?
  firstContactAt     DateTime           @default(now())
  firstMeetingAt     DateTime?
  responsibleId      String?
  responsible        User?              @relation("ProspectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities         ProspectActivity[]
  convertedClientId  String?
  convertedProjectId String?
  convertedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([responsibleId])
}

model ProspectActivity {
  id          String   @id @default(cuid())
  type        String
  note        String
  occurredAt  DateTime @default(now())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdById String?

  @@index([prospectId, occurredAt])
}

model FeeInvoice {
  id        String    @id @default(cuid())
  number    String
  amountHT  Decimal   @default(0)
  vatRate   Decimal   @default(20)
  issuedAt  DateTime
  paidAt    DateTime?
  status    String    @default("DRAFT")
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([issuedAt, status])
}
